@model List<AdvancePayment>
@{ ViewData["Title"] = "預支項目資料維護"; }

<div class="pt-3">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h5 class="mb-0 fw-semibold">
            <i class="bi bi-calendar-check me-2 text-primary"></i>預支項目資料維護
        </h5>
        <a asp-action="Create" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-lg me-1"></i>新增預支項目
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body d-flex flex-column align-items-center justify-content-center py-5 text-muted">
                <i class="bi bi-inbox fs-1 mb-3 text-secondary"></i>
                <p class="mb-0">尚無預支項目，請點右上角「新增預支項目」</p>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <table class="table table-hover table-sm mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th style="width:70px;" class="ps-3 text-center">序號</th>
                            <th style="width:140px;">分類</th>
                            <th>預支項目說明</th>
                            <th style="width:120px;" class="text-center">計費月份個數</th>
                            <th style="width:130px;" class="text-end">預支金額</th>
                            <th style="width:100px;" class="text-center pe-3">操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-3 text-center text-muted small">@item.SerialNo</td>
                                <td>
                                    <span class="badge rounded-pill"
                                          style="background:@item.Category.Color;font-size:0.75em;">
                                        @item.Category.Name
                                    </span>
                                </td>
                                <td class="small">@item.Name</td>
                                <td class="text-center small">@item.MonthCount 個月</td>
                                <td class="text-end fw-semibold">NT$ @item.Amount.ToString("N0")</td>
                                <td class="text-center pe-3">
                                    <a asp-action="Edit" asp-route-id="@item.SerialNo"
                                       class="btn btn-outline-primary btn-sm py-0 px-2">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@item.SerialNo"
                                          method="post" class="d-inline"
                                          onsubmit="return confirm('確認刪除此預支項目？');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger btn-sm py-0 px-2">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="text-muted small mt-2">共 @Model.Count 筆資料</div>
    }
</div>
