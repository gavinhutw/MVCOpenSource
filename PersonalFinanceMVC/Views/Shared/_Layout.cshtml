<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - 個人記帳系統</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
@{
    var ctrl        = ViewContext.RouteData.Values["controller"]?.ToString();
    var displayName = User.FindFirst("DisplayName")?.Value ?? User.Identity?.Name ?? "";
    var isAdmin     = User.FindFirst("IsAdmin")?.Value == "True";
    var pwdExpired  = User.FindFirst("PasswordExpired")?.Value == "True";
}

<div class="d-flex" style="min-height: 100vh;">
    <!-- ── Sidebar ──────────────────────────────────────────── -->
    <nav class="sidebar d-flex flex-column p-3 text-white"
         style="width: 230px; min-height: 100vh; background: #1e293b; flex-shrink: 0;">
        <a href="/" class="text-white text-decoration-none mb-3 d-flex align-items-center gap-2">
            <i class="bi bi-wallet2 fs-4 text-primary"></i>
            <span class="fw-bold fs-6">個人記帳系統</span>
        </a>

        <!-- 使用者資訊 -->
        <div class="bg-white bg-opacity-10 rounded p-2 mb-3 d-flex align-items-center gap-2">
            <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                 style="width:32px;height:32px;background:#3b82f6;">
                <i class="bi bi-person-fill text-white small"></i>
            </div>
            <div style="min-width:0;">
                <div class="small fw-semibold text-truncate">@displayName</div>
                <div class="d-flex align-items-center gap-1">
                    @if (isAdmin)
                    {
                        <span class="badge bg-danger" style="font-size:0.65em;">管理員</span>
                    }
                    @if (pwdExpired)
                    {
                        <span class="badge bg-warning text-dark" style="font-size:0.65em;">密碼到期</span>
                    }
                </div>
            </div>
        </div>

        <hr class="border-secondary my-1" />
        <ul class="nav nav-pills flex-column mb-auto gap-1">
            <li class="nav-item">
                <a asp-controller="Home" asp-action="Index"
                   class="nav-link text-white @(ctrl == "Home" ? "active" : "")">
                    <i class="bi bi-speedometer2 me-2"></i>總覽
                </a>
            </li>
            <li class="nav-item">
                <a asp-controller="Transactions" asp-action="Index"
                   class="nav-link text-white @(ctrl == "Transactions" ? "active" : "")">
                    <i class="bi bi-receipt me-2"></i>交易記錄
                </a>
            </li>
            <li class="nav-item">
                <a asp-controller="Accounts" asp-action="Index"
                   class="nav-link text-white @(ctrl == "Accounts" ? "active" : "")">
                    <i class="bi bi-bank me-2"></i>帳戶管理
                </a>
            </li>
            <li class="nav-item">
                <a asp-controller="Categories" asp-action="Index"
                   class="nav-link text-white @(ctrl == "Categories" ? "active" : "")">
                    <i class="bi bi-tags me-2"></i>分類管理
                </a>
            </li>
            <li class="nav-item">
                <a asp-controller="Reports" asp-action="Index"
                   class="nav-link text-white @(ctrl == "Reports" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
                    <i class="bi bi-bar-chart-line me-2"></i>報表分析
                </a>
            </li>
            <li class="nav-item">
                <a asp-controller="Reports" asp-action="LargeExpense"
                   class="nav-link text-white @(ctrl == "Reports" && ViewContext.RouteData.Values["action"]?.ToString() == "LargeExpense" ? "active" : "")">
                    <i class="bi bi-funnel me-2"></i>大額支出查詢
                </a>
            </li>
            @if (isAdmin)
            {
                <li class="mt-2">
                    <small class="text-secondary px-2" style="font-size:0.7em;">系統管理</small>
                </li>
                <li class="nav-item">
                    <a asp-controller="Users" asp-action="Index"
                       class="nav-link text-white @(ctrl == "Users" ? "active" : "")">
                        <i class="bi bi-people me-2"></i>使用者管理
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-controller="Users" asp-action="LoginLogs"
                       class="nav-link text-white">
                        <i class="bi bi-clock-history me-2"></i>登入記錄
                    </a>
                </li>
            }
        </ul>

        <hr class="border-secondary mt-1 mb-2" />
        <!-- 底部操作 -->
        <a asp-controller="Auth" asp-action="ChangePassword"
           class="nav-link text-white-50 py-1 small">
            <i class="bi bi-key me-2"></i>修改密碼
        </a>
        <form asp-controller="Auth" asp-action="Logout" method="post" class="mt-1">
            @Html.AntiForgeryToken()
            <button type="submit" class="nav-link text-white-50 py-1 small btn btn-link p-0 w-100 text-start">
                <i class="bi bi-box-arrow-left me-2"></i>登出
            </button>
        </form>
        <small class="text-secondary text-center mt-2">@DateTime.Now.ToString("yyyy/MM/dd")</small>
    </nav>

    <!-- ── Main Content ────────────────────────────────────── -->
    <div class="flex-grow-1 d-flex flex-column" style="background: #f8fafc; min-width: 0;">
        <!-- Top bar -->
        <header class="bg-white border-bottom px-4 py-2 d-flex align-items-center justify-content-between">
            <h6 class="mb-0 text-muted fw-normal">@ViewData["Title"]</h6>
            <small class="text-muted">
                <i class="bi bi-person-circle me-1"></i>@displayName
                &nbsp;|&nbsp;個人記帳系統 v1.0
            </small>
        </header>

        <!-- Alert messages -->
        <div class="px-4 pt-3">
            @if (pwdExpired)
            {
                <div class="alert alert-warning py-2 d-flex align-items-center gap-2">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <span>您的密碼已超過 90 天未變更，請盡快
                        <a asp-controller="Auth" asp-action="ChangePassword" class="alert-link">修改密碼</a>。
                    </span>
                </div>
            }
            @if (TempData["Success"] is string success)
            {
                <div class="alert alert-success alert-dismissible fade show py-2" role="alert">
                    <i class="bi bi-check-circle me-2"></i>@success
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] is string error)
            {
                <div class="alert alert-danger alert-dismissible fade show py-2" role="alert">
                    <i class="bi bi-exclamation-circle me-2"></i>@error
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
        </div>

        <main class="flex-grow-1 px-4 pb-4">
            @RenderBody()
        </main>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
