@model ReportViewModel
@{ ViewData["Title"] = "報表分析"; }

<div class="pt-3">
    <h5 class="mb-3 fw-semibold"><i class="bi bi-bar-chart-line me-2 text-primary"></i>報表分析</h5>

    <!-- 年月選擇 -->
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body py-3">
            <form method="get" asp-action="Index" class="row g-2 align-items-end">
                <div class="col-auto">
                    <label class="form-label small text-muted mb-1">年份</label>
                    <input type="number" name="year" class="form-control form-control-sm"
                           value="@Model.Year" min="2020" max="2099" style="width:100px;" />
                </div>
                <div class="col-auto">
                    <label class="form-label small text-muted mb-1">月份</label>
                    <select name="month" class="form-select form-select-sm" style="width:100px;">
                        @for (int m = 1; m <= 12; m++)
                        {
                            <option value="@m" selected="@(Model.Month == m)">@m 月</option>
                        }
                    </select>
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary btn-sm">
                        <i class="bi bi-arrow-clockwise me-1"></i>載入
                    </button>
                </div>
                <!-- 本月摘要 -->
                <div class="col-auto ms-auto d-flex gap-3">
                    <div class="text-center">
                        <div class="small text-muted">@Model.Year/@Model.Month 收入</div>
                        <div class="fw-bold text-success">NT$ @Model.MonthlyIncome.ToString("N0")</div>
                    </div>
                    <div class="text-center">
                        <div class="small text-muted">支出</div>
                        <div class="fw-bold text-danger">NT$ @Model.MonthlyExpense.ToString("N0")</div>
                    </div>
                    <div class="text-center">
                        <div class="small text-muted">結餘</div>
                        <div class="fw-bold @(Model.MonthlyNet >= 0 ? "text-success" : "text-danger")">
                            NT$ @Model.MonthlyNet.ToString("N0")
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="row g-3">
        <!-- 全年趨勢長條圖 -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0">
                    <h6 class="mb-0 fw-semibold">
                        <i class="bi bi-bar-chart me-2 text-primary"></i>@Model.Year 年收支趨勢
                    </h6>
                </div>
                <div class="card-body">
                    <canvas id="trendChart" height="180"></canvas>
                </div>
            </div>
        </div>

        <!-- 本月支出分類 -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0">
                    <h6 class="mb-0 fw-semibold">
                        <i class="bi bi-pie-chart me-2 text-primary"></i>@Model.Month 月支出分類
                    </h6>
                </div>
                <div class="card-body">
                    @if (Model.CategoryReports.Any())
                    {
                        <canvas id="categoryChart" height="220"></canvas>
                        <div class="mt-3">
                            @foreach (var r in Model.CategoryReports)
                            {
                                var pct = Model.MonthlyExpense > 0 ? (double)(r.Total / Model.MonthlyExpense * 100) : 0;
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <div class="d-flex align-items-center gap-2" style="min-width:0;">
                                        <span class="rounded-circle flex-shrink-0"
                                              style="width:10px;height:10px;display:inline-block;background:@r.Color;"></span>
                                        <small class="text-truncate">@r.CategoryName</small>
                                    </div>
                                    <div class="d-flex gap-2 text-end flex-shrink-0">
                                        <small class="fw-semibold">NT$ @r.Total.ToString("N0")</small>
                                        <small class="text-muted">@pct.ToString("F1")%</small>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="d-flex flex-column align-items-center justify-content-center py-4 text-muted">
                            <i class="bi bi-pie-chart fs-1 mb-2"></i>
                            <span>本月尚無支出記錄</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
// 年度趨勢圖
const trend = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
    Model.MonthlyTrend.Select(r => new { month = r.MonthLabel, income = (double)r.Income, expense = (double)r.Expense })
));
new Chart(document.getElementById('trendChart'), {
    type: 'bar',
    data: {
        labels: trend.map(r => r.month),
        datasets: [
            {
                label: '收入',
                data: trend.map(r => r.income),
                backgroundColor: 'rgba(34,197,94,0.7)',
                borderColor: 'rgba(34,197,94,1)',
                borderWidth: 1
            },
            {
                label: '支出',
                data: trend.map(r => r.expense),
                backgroundColor: 'rgba(239,68,68,0.7)',
                borderColor: 'rgba(239,68,68,1)',
                borderWidth: 1
            }
        ]
    },
    options: {
        responsive: true,
        plugins: { legend: { position: 'top' } },
        scales: { y: { beginAtZero: true } }
    }
});

// 分類圓餅圖
@if (Model.CategoryReports.Any())
{
    var labels = Model.CategoryReports.Select(r => r.CategoryName).ToArray();
    var data = Model.CategoryReports.Select(r => (double)r.Total).ToArray();
    var colors = Model.CategoryReports.Select(r => r.Color).ToArray();
    <text>
    new Chart(document.getElementById('categoryChart'), {
        type: 'doughnut',
        data: {
            labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(labels)),
            datasets: [{
                data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(data)),
                backgroundColor: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(colors)),
                borderWidth: 2,
                borderColor: '#fff'
            }]
        },
        options: {
            responsive: true,
            plugins: { legend: { display: false } },
            cutout: '60%'
        }
    });
    </text>
}
</script>
}
