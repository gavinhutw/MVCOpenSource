@model PersonalFinanceMVC.Models.ViewModels.UserFormViewModel
@{ ViewData["Title"] = "新增使用者"; }

<div class="pt-3">
    <div class="d-flex align-items-center gap-2 mb-3">
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left"></i></a>
        <h5 class="mb-0 fw-semibold"><i class="bi bi-person-plus me-2 text-primary"></i>新增使用者</h5>
    </div>
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

                        <div class="row g-3">
                            <div class="col-12">
                                <label asp-for="Username" class="form-label fw-semibold"></label>
                                <input asp-for="Username" class="form-control" placeholder="例：john_doe" />
                                <span asp-validation-for="Username" class="text-danger small"></span>
                                <small class="text-muted">只允許英文、數字及底線，3~50 字元</small>
                            </div>
                            <div class="col-12">
                                <label asp-for="DisplayName" class="form-label fw-semibold"></label>
                                <input asp-for="DisplayName" class="form-control" placeholder="例：王小明" />
                                <span asp-validation-for="DisplayName" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Email" class="form-label fw-semibold"></label>
                                <input asp-for="Email" class="form-control" placeholder="選填" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                            <div class="col-sm-6">
                                <label asp-for="Password" class="form-label fw-semibold">
                                    密碼 <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Password" type="password" class="form-control"
                                       placeholder="至少 8 個字元" />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>
                            <div class="col-sm-6">
                                <label asp-for="ConfirmPassword" class="form-label fw-semibold">
                                    確認密碼 <span class="text-danger">*</span>
                                </label>
                                <input asp-for="ConfirmPassword" type="password" class="form-control" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>
                            <div class="col-sm-6">
                                <div class="form-check form-switch mt-2">
                                    <input asp-for="IsAdmin" class="form-check-input" role="switch" />
                                    <label asp-for="IsAdmin" class="form-check-label fw-semibold">系統管理員</label>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="form-check form-switch mt-2">
                                    <input asp-for="IsActive" class="form-check-input" role="switch" />
                                    <label asp-for="IsActive" class="form-check-label fw-semibold">帳號啟用</label>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-primary flex-grow-1">
                                <i class="bi bi-check-lg me-1"></i>確認新增
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">取消</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
