@model PersonalFinanceMVC.Models.ViewModels.UserFormViewModel
@{ ViewData["Title"] = "編輯使用者"; }

<div class="pt-3">
    <div class="d-flex align-items-center gap-2 mb-3">
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left"></i></a>
        <h5 class="mb-0 fw-semibold"><i class="bi bi-person-gear me-2 text-primary"></i>編輯使用者</h5>
    </div>
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <!-- 帳號資訊卡 -->
            <div class="card border-0 bg-light mb-3">
                <div class="card-body py-3">
                    <div class="row text-center g-2">
                        <div class="col-4">
                            <div class="small text-muted">使用者代號</div>
                            <div class="fw-bold">@Model.Username</div>
                        </div>
                        <div class="col-4">
                            <div class="small text-muted">建立時間</div>
                            <div class="small">@Model.CreatedAt.ToString("yyyy/MM/dd")</div>
                        </div>
                        <div class="col-4">
                            <div class="small text-muted">密碼已使用</div>
                            <div class="fw-bold @(Model.PasswordAgeDays > 90 ? "text-danger" : "text-success")">
                                @Model.PasswordAgeDays 天
                                @if (Model.PasswordAgeDays > 90) { <span class="badge bg-danger ms-1">已到期</span> }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="Username" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

                        <div class="row g-3">
                            <div class="col-12">
                                <label asp-for="DisplayName" class="form-label fw-semibold"></label>
                                <input asp-for="DisplayName" class="form-control" />
                                <span asp-validation-for="DisplayName" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Email" class="form-label fw-semibold"></label>
                                <input asp-for="Email" class="form-control" />
                            </div>
                            <div class="col-sm-6">
                                <div class="form-check form-switch mt-2">
                                    <input asp-for="IsAdmin" class="form-check-input" role="switch" />
                                    <label asp-for="IsAdmin" class="form-check-label fw-semibold">系統管理員</label>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="form-check form-switch mt-2">
                                    <input asp-for="IsActive" class="form-check-input" role="switch" />
                                    <label asp-for="IsActive" class="form-check-label fw-semibold">帳號啟用</label>
                                </div>
                            </div>

                            <!-- 管理員重設密碼（選填）-->
                            <div class="col-12">
                                <hr />
                                <p class="small text-muted mb-2">
                                    <i class="bi bi-info-circle me-1"></i>若要重設密碼請填寫以下欄位，留空則不變更
                                </p>
                            </div>
                            <div class="col-sm-6">
                                <label asp-for="Password" class="form-label fw-semibold">新密碼（選填）</label>
                                <input asp-for="Password" type="password" class="form-control"
                                       placeholder="留空則不變更" autocomplete="new-password" />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>
                            <div class="col-sm-6">
                                <label asp-for="ConfirmPassword" class="form-label fw-semibold">確認新密碼</label>
                                <input asp-for="ConfirmPassword" type="password" class="form-control"
                                       autocomplete="new-password" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-primary flex-grow-1">
                                <i class="bi bi-check-lg me-1"></i>確認更新
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">取消</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
