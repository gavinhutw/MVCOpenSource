@model DashboardViewModel
@{ ViewData["Title"] = "總覽"; }

<div class="pt-3">
    <!-- 摘要卡片 -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #3b82f6 !important;">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small mb-1">總資產</div>
                        <div class="fs-4 fw-bold">NT$ @Model.TotalBalance.ToString("N0")</div>
                    </div>
                    <div class="rounded-circle d-flex align-items-center justify-content-center"
                         style="width:48px;height:48px;background:#eff6ff;">
                        <i class="bi bi-bank fs-4 text-primary"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #22c55e !important;">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small mb-1">本月收入</div>
                        <div class="fs-4 fw-bold text-success">NT$ @Model.MonthlyIncome.ToString("N0")</div>
                    </div>
                    <div class="rounded-circle d-flex align-items-center justify-content-center"
                         style="width:48px;height:48px;background:#f0fdf4;">
                        <i class="bi bi-arrow-up-circle fs-4 text-success"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #ef4444 !important;">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small mb-1">本月支出</div>
                        <div class="fs-4 fw-bold text-danger">NT$ @Model.MonthlyExpense.ToString("N0")</div>
                    </div>
                    <div class="rounded-circle d-flex align-items-center justify-content-center"
                         style="width:48px;height:48px;background:#fef2f2;">
                        <i class="bi bi-arrow-down-circle fs-4 text-danger"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100"
                 style="border-left: 4px solid @(Model.MonthlyNet >= 0 ? "#22c55e" : "#ef4444") !important;">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small mb-1">本月結餘</div>
                        <div class="fs-4 fw-bold @(Model.MonthlyNet >= 0 ? "text-success" : "text-danger")">
                            NT$ @Model.MonthlyNet.ToString("N0")
                        </div>
                    </div>
                    <div class="rounded-circle d-flex align-items-center justify-content-center"
                         style="width:48px;height:48px;background:@(Model.MonthlyNet >= 0 ? "#f0fdf4" : "#fef2f2");">
                        <i class="bi bi-piggy-bank fs-4 @(Model.MonthlyNet >= 0 ? "text-success" : "text-danger")"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <!-- 支出分類圓餅圖 -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-0 pb-0">
                    <h6 class="mb-0 fw-semibold">
                        <i class="bi bi-pie-chart me-2 text-primary"></i>本月支出分類
                    </h6>
                    <small class="text-muted">@DateTime.Now.ToString("yyyy年MM月")</small>
                </div>
                <div class="card-body">
                    @if (Model.CategoryReports.Any())
                    {
                        <canvas id="categoryChart" height="220"></canvas>
                        <div class="mt-3">
                            @foreach (var r in Model.CategoryReports.Take(5))
                            {
                                var pct = Model.MonthlyExpense > 0 ? (double)(r.Total / Model.MonthlyExpense * 100) : 0;
                                <div class="d-flex align-items-center justify-content-between mb-1">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="rounded-circle d-inline-block"
                                              style="width:10px;height:10px;background:@r.Color;"></span>
                                        <small>@r.CategoryName</small>
                                    </div>
                                    <small class="text-muted">@pct.ToString("F1")%</small>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="d-flex flex-column align-items-center justify-content-center py-5 text-muted">
                            <i class="bi bi-pie-chart fs-1 mb-2"></i>
                            <span>本月尚無支出記錄</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- 最近交易 -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-0 pb-0 d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 fw-semibold">
                        <i class="bi bi-clock-history me-2 text-primary"></i>最近交易
                    </h6>
                    <a asp-controller="Transactions" asp-action="Index" class="btn btn-sm btn-outline-primary">
                        查看全部 <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
                <div class="card-body p-0">
                    @if (Model.RecentTransactions.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-3">日期</th>
                                        <th>說明</th>
                                        <th>分類</th>
                                        <th>帳戶</th>
                                        <th class="text-end pe-3">金額</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var t in Model.RecentTransactions)
                                    {
                                        <tr>
                                            <td class="ps-3 text-muted small">@t.Date.ToString("MM/dd")</td>
                                            <td>
                                                <span class="text-truncate d-inline-block" style="max-width:160px;">
                                                    @(string.IsNullOrEmpty(t.Description) ? t.Category?.Name : t.Description)
                                                </span>
                                            </td>
                                            <td>
                                                <span class="badge rounded-pill"
                                                      style="background:@t.Category?.Color;font-size:0.75em;">
                                                    @t.Category?.Name
                                                </span>
                                            </td>
                                            <td class="small text-muted">@t.Account?.Name</td>
                                            <td class="text-end pe-3 fw-semibold @(t.Type == TransactionType.Income ? "text-success" : "text-danger")">
                                                @(t.Type == TransactionType.Income ? "+" : "-")NT$ @t.Amount.ToString("N0")
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex flex-column align-items-center justify-content-center py-5 text-muted">
                            <i class="bi bi-receipt fs-1 mb-2"></i>
                            <span>尚無交易記錄</span>
                            <a asp-controller="Transactions" asp-action="Create"
                               class="btn btn-primary btn-sm mt-2">新增第一筆交易</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    @if (Model.CategoryReports.Any())
    {
        var labels = Model.CategoryReports.Select(r => r.CategoryName).ToArray();
        var data = Model.CategoryReports.Select(r => (double)r.Total).ToArray();
        var colors = Model.CategoryReports.Select(r => r.Color).ToArray();
        <text>
        new Chart(document.getElementById('categoryChart'), {
            type: 'doughnut',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(labels)),
                datasets: [{
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(data)),
                    backgroundColor: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(colors)),
                    borderWidth: 2,
                    borderColor: '#fff'
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { display: false } },
                cutout: '65%'
            }
        });
        </text>
    }
</script>
}
