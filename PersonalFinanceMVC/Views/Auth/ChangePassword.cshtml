@model ChangePasswordViewModel
@{ ViewData["Title"] = "修改密碼"; }

<div class="pt-3">
    <div class="d-flex align-items-center gap-2 mb-3">
        @if (!Model.IsExpired)
        {
            <a asp-controller="Home" asp-action="Index" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-arrow-left"></i>
            </a>
        }
        <h5 class="mb-0 fw-semibold">
            <i class="bi bi-key me-2 text-primary"></i>修改密碼
        </h5>
    </div>

    @if (Model.IsExpired)
    {
        <div class="alert alert-warning d-flex align-items-start gap-2 mb-4">
            <i class="bi bi-exclamation-triangle-fill fs-5 flex-shrink-0 mt-1"></i>
            <div>
                <strong>密碼已超過 90 天未變更</strong><br />
                <span class="small">為確保帳號安全，請立即變更密碼後才能繼續使用系統。</span>
            </div>
        </div>
    }

    <div class="row justify-content-center">
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <form asp-action="ChangePassword" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="CurrentPassword" class="form-label fw-semibold"></label>
                            <input asp-for="CurrentPassword" class="form-control" />
                            <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                        </div>

                        <hr class="my-3" />

                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label fw-semibold"></label>
                            <input asp-for="NewPassword" class="form-control" id="newPwd" />
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>

                            <!-- 密碼強度指示 -->
                            <div class="progress mt-2" style="height:4px;">
                                <div id="pwdStrengthBar" class="progress-bar" style="width:0%"></div>
                            </div>
                            <small id="pwdStrengthText" class="text-muted"></small>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="form-label fw-semibold"></label>
                            <input asp-for="ConfirmPassword" class="form-control" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary py-2 fw-semibold">
                                <i class="bi bi-check-lg me-1"></i>確認變更密碼
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="card border-0 shadow-sm mt-3">
                <div class="card-body py-3">
                    <p class="small text-muted mb-1 fw-semibold">密碼規則</p>
                    <ul class="small text-muted mb-0 ps-3">
                        <li>至少 8 個字元</li>
                        <li>建議包含大寫、小寫字母及數字</li>
                        <li>建議包含特殊符號（如 !#$%^&amp;*@@）</li>
                        <li>不得與目前密碼相同</li>
                        <li>每 90 天須更換一次</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
document.getElementById('newPwd').addEventListener('input', function () {
    const v = this.value;
    let score = 0;
    if (v.length >= 8) score++;
    if (/[A-Z]/.test(v)) score++;
    if (/[a-z]/.test(v)) score++;
    if (/[0-9]/.test(v)) score++;
    if (/[^A-Za-z0-9]/.test(v)) score++;

    const bar = document.getElementById('pwdStrengthBar');
    const txt = document.getElementById('pwdStrengthText');
    const levels = [
        { w: '20%', cls: 'bg-danger',  label: '非常弱' },
        { w: '40%', cls: 'bg-warning', label: '弱' },
        { w: '60%', cls: 'bg-info',    label: '中等' },
        { w: '80%', cls: 'bg-primary', label: '強' },
        { w: '100%', cls: 'bg-success', label: '非常強' },
    ];
    const level = score > 0 ? levels[score - 1] : { w: '0%', cls: '', label: '' };
    bar.style.width = level.w;
    bar.className = 'progress-bar ' + level.cls;
    txt.textContent = level.label ? '密碼強度：' + level.label : '';
});
</script>
}
