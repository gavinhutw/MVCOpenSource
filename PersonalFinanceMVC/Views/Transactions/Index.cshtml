@model TransactionFilterViewModel
@{ ViewData["Title"] = "交易記錄"; }

<div class="pt-3">
    <!-- 標題列 -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="mb-0 fw-semibold"><i class="bi bi-receipt me-2 text-primary"></i>交易記錄</h5>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>新增交易
        </a>
    </div>

    <!-- 篩選表單 -->
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body py-3">
            <form method="get" asp-action="Index" class="row g-2 align-items-end">
                <div class="col-sm-6 col-md-2">
                    <label class="form-label small text-muted mb-1">開始日期</label>
                    <input type="date" name="startDate" class="form-control form-control-sm"
                           value="@Model.StartDate?.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-sm-6 col-md-2">
                    <label class="form-label small text-muted mb-1">結束日期</label>
                    <input type="date" name="endDate" class="form-control form-control-sm"
                           value="@Model.EndDate?.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-sm-6 col-md-2">
                    <label class="form-label small text-muted mb-1">帳戶</label>
                    <select name="accountId" class="form-select form-select-sm">
                        <option value="">全部帳戶</option>
                        @foreach (var a in Model.Accounts)
                        {
                            <option value="@a.Id" selected="@(Model.AccountId == a.Id)">@a.Name</option>
                        }
                    </select>
                </div>
                <div class="col-sm-6 col-md-2">
                    <label class="form-label small text-muted mb-1">類型</label>
                    <select name="type" class="form-select form-select-sm">
                        <option value="">全部類型</option>
                        <option value="Income" selected="@(Model.Type == TransactionType.Income)">收入</option>
                        <option value="Expense" selected="@(Model.Type == TransactionType.Expense)">支出</option>
                    </select>
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary btn-sm">
                        <i class="bi bi-search me-1"></i>篩選
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm ms-1">
                        <i class="bi bi-x-lg"></i> 清除
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- 統計列 -->
    <div class="row g-2 mb-3">
        <div class="col-4">
            <div class="card border-0 bg-success bg-opacity-10 text-center py-2">
                <div class="small text-muted">收入總計</div>
                <div class="fw-bold text-success">NT$ @Model.TotalIncome.ToString("N0")</div>
            </div>
        </div>
        <div class="col-4">
            <div class="card border-0 bg-danger bg-opacity-10 text-center py-2">
                <div class="small text-muted">支出總計</div>
                <div class="fw-bold text-danger">NT$ @Model.TotalExpense.ToString("N0")</div>
            </div>
        </div>
        <div class="col-4">
            <div class="card border-0 @(Model.Net >= 0 ? "bg-success" : "bg-danger") bg-opacity-10 text-center py-2">
                <div class="small text-muted">淨收支</div>
                <div class="fw-bold @(Model.Net >= 0 ? "text-success" : "text-danger")">
                    NT$ @Model.Net.ToString("N0")
                </div>
            </div>
        </div>
    </div>

    <!-- 資料表 -->
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">日期</th>
                        <th>說明</th>
                        <th>分類</th>
                        <th>帳戶</th>
                        <th>類型</th>
                        <th class="text-end">金額</th>
                        <th class="text-center pe-3">操作</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Transactions.Any())
                    {
                        @foreach (var t in Model.Transactions)
                        {
                            <tr>
                                <td class="ps-3 text-muted small">@t.Date.ToString("yyyy/MM/dd")</td>
                                <td>@(string.IsNullOrEmpty(t.Description) ? "—" : t.Description)</td>
                                <td>
                                    <span class="badge rounded-pill"
                                          style="background:@t.Category?.Color;font-size:0.78em;">
                                        @t.Category?.Name
                                    </span>
                                </td>
                                <td class="small">@t.Account?.Name</td>
                                <td>
                                    @if (t.Type == TransactionType.Income)
                                    {
                                        <span class="badge bg-success-subtle text-success">收入</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger">支出</span>
                                    }
                                </td>
                                <td class="text-end fw-semibold @(t.Type == TransactionType.Income ? "text-success" : "text-danger")">
                                    @(t.Type == TransactionType.Income ? "+" : "-")NT$ @t.Amount.ToString("N0")
                                </td>
                                <td class="text-center pe-3">
                                    <a asp-action="Edit" asp-route-id="@t.Id"
                                       class="btn btn-sm btn-outline-primary me-1">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-danger"
                                            onclick="confirmDelete(@t.Id, '@(string.IsNullOrEmpty(t.Description) ? t.Category?.Name : t.Description)', @t.Amount)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-search fs-3 d-block mb-2"></i>
                                沒有符合條件的記錄
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Delete Confirm Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h6 class="modal-title">確認刪除</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="mb-1">確定要刪除這筆交易嗎？</p>
                <p class="text-muted small mb-0" id="deleteDesc"></p>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">取消</button>
                <form id="deleteForm" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger btn-sm">刪除</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
function confirmDelete(id, desc, amount) {
    document.getElementById('deleteDesc').textContent = desc + ' - NT$ ' + Number(amount).toLocaleString();
    document.getElementById('deleteForm').action = '/Transactions/Delete/' + id;
    new bootstrap.Modal(document.getElementById('deleteModal')).show();
}
</script>
}
